@model FerreteriaValdiviaNueva.Models.Producto

@{
    ViewData["Title"] = "Editar Producto";
}

<div class="container mt-4">
    <h2>Editar Producto</h2>
    <hr />

    <div class="row">
        <div class="col-md-6">
            <form asp-action="Edit">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                
                <input type="hidden" asp-for="CodigoProducto" />

                <div class="mb-3">
                    <label class="form-label"><strong>Código:</strong> @Model.CodigoProducto</label>
                </div>

                <div class="mb-3">
                    <label asp-for="Nombre_Producto" class="form-label">Nombre del Producto</label>
                    <input asp-for="Nombre_Producto" class="form-control" required />
                    <span asp-validation-for="Nombre_Producto" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="PrecioVenta" class="form-label">Precio de Venta (Bs)</label>
                    <input asp-for="PrecioVenta" class="form-control" type="number" step="0.01" required />
                    <span asp-validation-for="PrecioVenta" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="StockMinimo" class="form-label">Stock Mínimo</label>
                    <input asp-for="StockMinimo" class="form-control" type="number" />
                </div>

                <div class="mb-3">
                    <label asp-for="StockActual" class="form-label">Stock Actual</label>
                    <input asp-for="StockActual" class="form-control" type="number" />
                </div>

                <div class="mb-3">
                    <label asp-for="id_Categoria" class="form-label">Categoría</label>
                    <select asp-for="id_Categoria" class="form-select" asp-items="ViewBag.id_Categoria">
                        <option value="">-- Seleccione una Categoría --</option>
                    </select>
                </div>

                <div class="mb-3">
                    <label asp-for="id_Proveedor" class="form-label">Proveedor</label>
                    <select asp-for="id_Proveedor" class="form-select" asp-items="ViewBag.id_Proveedor">
                        <option value="">-- Seleccione un Proveedor --</option>
                    </select>
                </div>

                <div class="mt-4">
                    <button type="submit" class="btn btn-primary">💾 Actualizar Cambios</button>
                    <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}