@model IEnumerable<FerreteriaValdiviaNueva.Models.Producto>

@{
    ViewData["Title"] = "Inventario de Productos";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Inventario de Productos - Ferretería Valdivia</h2>
        <div>
            <!-- Botón para ir al panel estadístico -->
            <a asp-action="Estadisticas" class="btn btn-info text-white me-2">📊 Ver Estadísticas</a>
            <a asp-action="Create" class="btn btn-primary">+ Nuevo Producto</a>
        </div>
    </div>
    <hr />

    <table class="table table-striped table-bordered shadow-sm">
        <thead class="table-dark">
            <tr>
                <th>Código</th>
                <th>Nombre</th>
                <th>Precio Venta</th>
                <th>Stock</th>
                <th>ID Cat.</th>
                <th>ID Prov.</th>
                <th>Vendidos</th>
                <th class="text-center">Acciones</th>
            </tr>
        </thead>
        <tbody>
            @if (Model != null) {
                foreach (var item in Model) {
                    <tr>
                        <td>@item.CodigoProducto</td>
                        <td>@item.Nombre_Producto</td>
                        <td>@item.PrecioVenta.ToString("F2") Bs</td>
                        <td>@item.StockActual</td>
                        <td>@item.id_Categoria</td>
                        <td>@item.id_Proveedor</td>
                        <td>@item.CantidadVendida unid.</td>
                        <td class="text-center">
                            <a asp-action="Edit" asp-route-id="@item.CodigoProducto" class="btn btn-sm btn-warning">✏️ Editar</a>
                            <a asp-action="Delete" asp-route-id="@item.CodigoProducto" class="btn btn-sm btn-danger">🗑️ Eliminar</a>
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>