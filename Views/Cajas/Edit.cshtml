@model FerreteriaValdiviaNueva.Models.Caja

@{
    ViewData["Title"] = "Editar Caja";
}

<div class="container mt-4">
    <h2>Editar Registro de Caja</h2>
    <hr />

    <div class="row">
        <div class="col-md-6">
            <form asp-action="Edit">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                <input type="hidden" asp-for="IdCaja" />

                <div class="mb-3">
                    <label asp-for="FechaApertura" class="form-label">Fecha de Apertura</label>
                    <input asp-for="FechaApertura" class="form-control" type="datetime-local" required />
                    <span asp-validation-for="FechaApertura" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="FechaCierre" class="form-label">Fecha de Cierre</label>
                    <input asp-for="FechaCierre" class="form-control" type="datetime-local" />
                </div>

                <div class="mb-3">
                    <label asp-for="MontoInicial" class="form-label">Monto Inicial (Bs)</label>
                    <input asp-for="MontoInicial" class="form-control" type="number" step="0.01" required />
                    <span asp-validation-for="MontoInicial" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="MontoFinal" class="form-label">Monto Final (Bs)</label>
                    <input asp-for="MontoFinal" class="form-control" type="number" step="0.01" />
                </div>

                <div class="mb-3">
                    <label asp-for="Estado" class="form-label">Estado</label>
                    <select asp-for="Estado" class="form-select" required>
                        <option value="Abierta">Abierta</option>
                        <option value="Cerrada">Cerrada</option>
                    </select>
                    <span asp-validation-for="Estado" class="text-danger"></span>
                </div>

                <div class="mt-4">
                    <button type="submit" class="btn btn-primary">💾 Actualizar Cambios</button>
                    <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}