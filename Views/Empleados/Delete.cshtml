@model FerreteriaValdiviaNueva.Models.Empleado

@{
    ViewData["Title"] = "Eliminar Empleado";
}

<div class="container mt-4">
    <h2>Eliminar Empleado</h2>
    <h3 class="text-danger">¿Estás seguro de que deseas eliminar este empleado?</h3>
    <hr />

    <div>
        <dl class="row">
            <dt class="col-sm-3">ID:</dt>
            <dd class="col-sm-9">@Model.IdEmpleado</dd>

            <dt class="col-sm-3">Nombre:</dt>
            <dd class="col-sm-9">@Model.Nombre @Model.Apellido</dd>

            <dt class="col-sm-3">Teléfono:</dt>
            <dd class="col-sm-9">@(Model.Telefono ?? "Sin Teléfono")</dd>

            <dt class="col-sm-3">Rol:</dt>
            <dd class="col-sm-9">@(Model.Rol?.NombreRol ?? "Sin Rol")</dd>
        </dl>
        
        <form asp-action="Delete">
            <input type="hidden" asp-for="IdEmpleado" />
            <button type="submit" class="btn btn-danger">Sí, Eliminar</button>
            <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
        </form>
    </div>
</div>