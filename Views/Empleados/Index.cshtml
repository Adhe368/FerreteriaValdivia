@model IEnumerable<FerreteriaValdiviaNueva.Models.Empleado>

@{
    ViewData["Title"] = "Gestión de Empleados";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Gestión de Empleados</h2>
        <a asp-action="Create" class="btn btn-primary">➕ Nuevo Empleado</a>
    </div>
    <hr />

    <table class="table table-striped table-bordered shadow-sm">
        <thead class="table-dark">
            <tr>
                <th>ID</th>
                <th>Nombre</th>
                <th>Apellido</th>
                <th>Teléfono</th>
                <th>Rol</th>
                <th class="text-center">Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model) {
                <tr>
                    <td>@item.IdEmpleado</td>
                    <td>@item.Nombre</td>
                    <td>@item.Apellido</td>
                    <td>@(item.Telefono ?? "Sin Teléfono")</td>
                    <td>@(item.Rol?.NombreRol ?? "Sin Rol")</td>
                    <td class="text-center">
                        <a asp-action="Edit" asp-route-id="@item.IdEmpleado" class="btn btn-sm btn-warning">✏️ Editar</a>
                        <a asp-action="Delete" asp-route-id="@item.IdEmpleado" class="btn btn-sm btn-danger">🗑️ Eliminar</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>