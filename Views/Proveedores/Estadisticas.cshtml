@{
    ViewData["Title"] = "Estadísticas de Proveedores";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>📊 Panel Estadístico de Proveedores</h2>
        <a asp-action="Index" class="btn btn-secondary">← Volver al Listado</a>
    </div>

    <div class="row">
        <!-- Tarjeta 1: Total de Proveedores -->
        <div class="col-md-6 mb-3">
            <div class="card text-white bg-primary shadow-sm">
                <div class="card-body">
                    <h5 class="card-title">🏢 Total de Proveedores</h5>
                    <h3 class="display-6 fw-bold">@ViewBag.TotalProveedores</h3>
                    <p class="card-text">Cantidad total de aliados comerciales registrados (COUNT).</p>
                </div>
            </div>
        </div>

        <!-- Tarjeta 2: Primer Proveedor -->
        <div class="col-md-6 mb-3">
            <div class="card border-primary shadow-sm">
                <div class="card-header bg-primary text-white fw-bold">📌 Proveedor Inicial</div>
                <div class="card-body">
                    <h4 class="card-title text-dark">@ViewBag.PrimerProveedor</h4>
                    <p class="card-text fs-5 text-muted">Primer registro base en la base de datos.</p>
                </div>
            </div>
        </div>
    </div>
</div>