@model FerreteriaValdiviaNueva.Models.Proveedor

@{
    ViewData["Title"] = "Nuevo Proveedor";
}

<div class="container mt-4">
    <h2>Registrar Nuevo Proveedor</h2>
    <hr />

    <div class="row">
        <div class="col-md-6">
            <form asp-action="Create">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                <div class="mb-3">
                    <label asp-for="NombreProveedor" class="form-label">Nombre del Proveedor</label>
                    <input asp-for="NombreProveedor" class="form-control" required />
                    <span asp-validation-for="NombreProveedor" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Telefono" class="form-label">Teléfono</label>
                    <input asp-for="Telefono" class="form-control" />
                    <span asp-validation-for="Telefono" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Direccion" class="form-label">Dirección</label>
                    <input asp-for="Direccion" class="form-control" />
                    <span asp-validation-for="Direccion" class="text-danger"></span>
                </div>

                <div class="mt-4">
                    <button type="submit" class="btn btn-success">💾 Guardar Proveedor</button>
                    <a asp-action="Index" class="btn btn-secondary">Volver al Listado</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}