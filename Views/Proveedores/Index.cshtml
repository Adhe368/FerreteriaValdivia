@model IEnumerable<FerreteriaValdiviaNueva.Models.Proveedor>

@{
    ViewData["Title"] = "Gestión de Proveedores";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Gestión de Proveedores</h2>
        <div>
            <!-- Botón para ver estadísticas del módulo -->
            <a asp-action="Estadisticas" class="btn btn-info text-white me-2">📊 Ver Estadísticas</a>
            <a asp-action="Create" class="btn btn-primary">+ Nuevo Proveedor</a>
        </div>
    </div>
    <hr />

    <table class="table table-striped table-bordered shadow-sm">
        <thead class="table-dark">
            <tr>
                <th>ID</th>
                <th>Nombre</th>
                <th>Teléfono</th>
                <th>Dirección</th>
                <th class="text-center">Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model) {
                <tr>
                    <td>@item.IdProveedor</td>
                    <td>@item.NombreProveedor</td>
                    <td>@(item.Telefono ?? "Sin Teléfono")</td>
                    <td>@(item.Direccion ?? "Sin Dirección")</td>
                    <td class="text-center">
                        <a asp-action="Edit" asp-route-id="@item.IdProveedor" class="btn btn-sm btn-warning">✏️ Editar</a>
                        <a asp-action="Delete" asp-route-id="@item.IdProveedor" class="btn btn-sm btn-danger">🗑️ Eliminar</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>