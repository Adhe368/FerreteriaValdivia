@model FerreteriaValdiviaNueva.Models.Categoria

@{
    ViewData["Title"] = "Eliminar Categoría";
}

<div class="container mt-4">
    <h2>Eliminar Categoría</h2>
    <h3 class="text-danger">¿Estás seguro de que deseas eliminar esta categoría?</h3>
    <hr />

    <div>
        <dl class="row">
            <dt class="col-sm-3">ID:</dt>
            <dd class="col-sm-9">@Model.IdCategoria</dd>

            <dt class="col-sm-3">Nombre:</dt>
            <dd class="col-sm-9">@Model.NombreCategoria</dd>
        </dl>
        
        <form asp-action="Delete">
            <input type="hidden" asp-for="IdCategoria" />
            <button type="submit" class="btn btn-danger">Sí, Eliminar</button>
            <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
        </form>
    </div>
</div>