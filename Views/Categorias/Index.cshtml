@model IEnumerable<FerreteriaValdiviaNueva.Models.Categoria>

@{
    ViewData["Title"] = "Gestión de Categorías";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>Gestión de Categorías</h2>
        <a asp-action="Create" class="btn btn-primary">➕ Nueva Categoría</a>
    </div>
    <hr />

    <table class="table table-striped table-bordered shadow-sm">
        <thead class="table-dark">
            <tr>
                <th>ID</th>
                <th>Nombre de la Categoría</th>
                <th class="text-center">Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model) {
                <tr>
                    <td>@item.IdCategoria</td>
                    <td>@item.NombreCategoria</td>
                    <td class="text-center">
                        <a asp-action="Edit" asp-route-id="@item.IdCategoria" class="btn btn-sm btn-warning">✏️ Editar</a>
                        <a asp-action="Delete" asp-route-id="@item.IdCategoria" class="btn btn-sm btn-danger">🗑️ Eliminar</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>