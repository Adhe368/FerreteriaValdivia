@{
    ViewData["Title"] = "Estadísticas de Clientes";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>📊 Panel Estadístico de Clientes</h2>
        <a asp-action="Index" class="btn btn-secondary">← Volver al Listado</a>
    </div>

    <div class="row">
        <!-- Tarjeta 1: Total de Clientes -->
        <div class="col-md-6 mb-3">
            <div class="card text-white bg-primary shadow-sm">
                <div class="card-body">
                    <h5 class="card-title">👥 Total de Clientes</h5>
                    <h3 class="display-6 fw-bold">@ViewBag.TotalClientes</h3>
                    <p class="card-text">Cantidad total de clientes registrados en el sistema (COUNT).</p>
                </div>
            </div>
        </div>

        <!-- Tarjeta 2: Primer Cliente -->
        <div class="col-md-6 mb-3">
            <div class="card border-success shadow-sm">
                <div class="card-header bg-success text-white fw-bold">📌 Primer Cliente Registrado</div>
                <div class="card-body">
                    <h4 class="card-title text-dark">@ViewBag.PrimerCliente</h4>
                    <p class="card-text fs-5 text-muted">Cliente inicial base del sistema.</p>
                </div>
            </div>
        </div>
    </div>
</div>