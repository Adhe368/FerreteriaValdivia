@{
    ViewData["Title"] = "Estadísticas de Roles";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>📊 Panel Estadístico de Roles</h2>
        <a asp-action="Index" class="btn btn-secondary">← Volver al Listado</a>
    </div>

    <div class="row">
        <!-- Tarjeta 1: Total de Roles -->
        <div class="col-md-6 mb-3">
            <div class="card text-white bg-primary shadow-sm">
                <div class="card-body">
                    <h5 class="card-title">🛡️ Total de Roles</h5>
                    <h3 class="display-6 fw-bold">@ViewBag.TotalRoles</h3>
                    <p class="card-text">Cantidad total de perfiles de permisos en el sistema (COUNT).</p>
                </div>
            </div>
        </div>

        <!-- Tarjeta 2: Primer Rol -->
        <div class="col-md-6 mb-3">
            <div class="card border-warning shadow-sm">
                <div class="card-header bg-warning text-dark fw-bold">📌 Rol Inicial</div>
                <div class="card-body">
                    <h4 class="card-title text-dark">@ViewBag.PrimerRol</h4>
                    <p class="card-text fs-5 text-muted">Perfil de acceso base del sistema.</p>
                </div>
            </div>
        </div>
    </div>
</div>