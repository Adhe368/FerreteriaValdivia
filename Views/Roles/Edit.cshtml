@model FerreteriaValdiviaNueva.Models.Rol

@{
    ViewData["Title"] = "Editar Rol";
}

<div class="container mt-4">
    <h2>Editar Rol</h2>
    <hr />

    <div class="row">
        <div class="col-md-6">
            <form asp-action="Edit">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                <input type="hidden" asp-for="IdRol" />

                <div class="mb-3">
                    <label asp-for="NombreRol" class="form-label">Nombre del Rol</label>
                    <input asp-for="NombreRol" class="form-control" required />
                    <span asp-validation-for="NombreRol" class="text-danger"></span>
                </div>

                <div class="mt-4">
                    <button type="submit" class="btn btn-primary">💾 Actualizar Cambios</button>
                    <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}